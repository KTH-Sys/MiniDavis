# Copy to backend/.env. Baseline needs no API key and makes no provider calls.
MINIDAVIS_MODE=baseline
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# To enable hosted decisions, set MINIDAVIS_MODE=llm and add your server key below.
# Run scripts/check_groq.py --live first; baseline never makes provider calls.
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MIN_AGENT_REPLAN_SECONDS=30
LLM_MAX_REQUESTS_PER_MINUTE=4
LLM_MAX_CALLS_PER_RUN=20
LLM_MAX_CALLS_PER_DAY=500
LLM_MAX_TOKENS_PER_DAY=160000
LLM_MAX_INPUT_TOKENS=800
LLM_MAX_COMPLETION_TOKENS=512

# Day 4: install requirements-ml.txt, then choose semantic to enable CPU MiniLM.
# Lexical stays the reproducible, no-download default. Model failure falls back to it.
MEMORY_RETRIEVAL_MODE=lexical
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_CACHE_PATH=data/model-cache
# Day 5–6: classifier training/loading remains separate.
CLASSIFIER_MODEL_PATH=ml/artifacts/classifier
MEMORY_DB_PATH=data/minidavis.sqlite
